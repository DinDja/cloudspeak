rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isSlideType(value) {
      return value in ['multiple_choice', 'word_cloud', 'open_text', 'team_selection'];
    }

    function isValidSessionCode(value) {
      return value is string && value.matches('^[A-Z0-9]{6}$');
    }

    function isSecDomain(email) {
      return email is string
        && email.matches('.*@(secti\\.ba\\.gov\\.br|enova\\.educacao\\.ba\\.gov\\.br|gmail\\.com)$');
    }

    function isSecUser() {
      return request.auth != null
        && isSecDomain(request.auth.token.email);
    }

    function matchesAuthUser(ownerUid, ownerEmail) {
      return ownerUid == request.auth.uid
        && ownerEmail == request.auth.token.email;
    }

    // Validação de envelope dos slides (validação profunda por slide fica no app).
    function isValidSlides(slides) {
      return slides is list && slides.size() > 0 && slides.size() <= 20;
    }

    function sessionOwner(code) {
      return isSecUser()
        && get(/databases/$(database)/documents/sessions/$(code)).data.ownerUid == request.auth.uid;
    }

    // ---------- Apresentações (decks salvos e editáveis) ----------
    match /presentations/{presentationId} {
      allow read: if isSecUser() && resource.data.ownerUid == request.auth.uid;

      allow create: if isSecUser()
        && request.resource.data.keys().hasOnly(['title', 'slides', 'ownerUid', 'ownerEmail', 'eventKey', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['title', 'slides', 'ownerUid', 'ownerEmail', 'createdAt', 'updatedAt'])
        && matchesAuthUser(request.resource.data.ownerUid, request.resource.data.ownerEmail)
        && isString(request.resource.data.title, 1, 120)
        && isValidSlides(request.resource.data.slides)
        && (!request.resource.data.keys().hasAll(['eventKey'])
            || request.resource.data.eventKey == null
            || isString(request.resource.data.eventKey, 1, 80))
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
        // eventKey identifies an institutional event template and is optional for old decks.

      allow update: if isSecUser()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['title', 'slides', 'ownerUid', 'ownerEmail', 'eventKey', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && isString(request.resource.data.title, 1, 120)
        && isValidSlides(request.resource.data.slides)
        && (!request.resource.data.keys().hasAll(['eventKey'])
            || request.resource.data.eventKey == null
            || isString(request.resource.data.eventKey, 1, 80))
        && request.resource.data.updatedAt is timestamp;

      allow delete: if isSecUser() && resource.data.ownerUid == request.auth.uid;
    }

    // ---------- Escutas independentes de apresentações ----------
    match /listeningForms/{formId} {
      // Acesso da equipe através da própria escuta (campos opcionais, escritos
      // sempre juntos pelo dono): editorEmails pode editar conteúdo e
      // encerrar/reabrir; viewerEmails apenas acompanha os resultados.
      // Escutas antigas sem esses campos continuam acessíveis somente ao dono,
      // e o público continua lendo escutas com status 'open'.
      function isValidTeamEmailList(value) {
        return value is list
          && value.size() <= 20
          && value.size() == value.toSet().size();
      }

      function teamEmailFieldsAreValid() {
        return !request.resource.data.keys().hasAny(['editorEmails', 'viewerEmails'])
          || (!(request.resource.data.get('editorEmails', []).hasAny(request.resource.data.get('viewerEmails', [])))
            && (!request.resource.data.keys().hasAll(['editorEmails'])
                || isValidTeamEmailList(request.resource.data.editorEmails))
            && (!request.resource.data.keys().hasAll(['viewerEmails'])
                || isValidTeamEmailList(request.resource.data.viewerEmails)));
      }

      function isListeningTeamViewer() {
        return isSecUser()
          && request.auth.token.email.lower() in resource.data.get('viewerEmails', []);
      }

      function isListeningTeamEditor() {
        return isSecUser()
          && request.auth.token.email.lower() in resource.data.get('editorEmails', []);
      }

      allow get: if resource.data.status == 'open'
        || isListeningTeamViewer()
        || isListeningTeamEditor()
        || (isSecUser() && resource.data.ownerUid == request.auth.uid);
      allow list: if isListeningTeamViewer()
        || isListeningTeamEditor()
        || (isSecUser() && resource.data.ownerUid == request.auth.uid);

      allow create: if isSecUser()
        && request.resource.data.keys().hasOnly([
          'title', 'introduction', 'topicPrompt', 'consultationPeriod', 'mode', 'maxTitleSelections', 'options', 'schoolIds',
          'status', 'ownerUid', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'title', 'introduction', 'topicPrompt', 'consultationPeriod', 'mode', 'maxTitleSelections', 'options', 'schoolIds',
          'status', 'ownerUid', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && isString(request.resource.data.title, 3, 120)
                && isString(request.resource.data.introduction, 0, 5000)
        && isString(request.resource.data.topicPrompt, 5, 180)
        && isString(request.resource.data.consultationPeriod, 0, 180)
        && request.resource.data.mode in ['open', 'vote', 'vote_simple']
        && request.resource.data.maxTitleSelections is int
        && request.resource.data.maxTitleSelections >= 1
        && request.resource.data.maxTitleSelections <= 30
        && request.resource.data.options is list
        && (request.resource.data.mode == 'open'
            ? request.resource.data.options.size() == 0
            : request.resource.data.options.size() >= 2
              && request.resource.data.options.size() <= 10)
        && request.resource.data.schoolIds is list
        && request.resource.data.schoolIds.size() > 0
        && request.resource.data.schoolIds.size() <= 2000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // O dono altera tudo (inclusive as listas da equipe);
      // editores da equipe alteram apenas conteúdo e status — nunca dono,
      // histórico, unidades escolares ou listas de acesso.
      function isListeningOwnerUpdate() {
        return isSecUser()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'title', 'introduction', 'topicPrompt', 'consultationPeriod',
            'mode', 'maxTitleSelections', 'options', 'editorEmails', 'viewerEmails', 'updatedAt'
          ]);
      }

      function isListeningTeamEditorUpdate() {
        return request.auth.token.email.lower() in resource.data.get('editorEmails', [])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'title', 'introduction', 'topicPrompt', 'consultationPeriod',
            'mode', 'maxTitleSelections', 'options', 'updatedAt'
          ]);
      }

      function isListeningContentUpdateValid() {
        return request.resource.data.status in ['open', 'closed']
          && request.resource.data.updatedAt == request.time
          && isString(request.resource.data.title, 3, 120)
                  && isString(request.resource.data.introduction, 0, 5000)
          && isString(request.resource.data.topicPrompt, 5, 180)
          && isString(request.resource.data.consultationPeriod, 0, 180)
          && request.resource.data.mode in ['open', 'vote', 'vote_simple']
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['maxTitleSelections'])
              || (request.resource.data.maxTitleSelections is int
                  && request.resource.data.maxTitleSelections >= 1
                  && request.resource.data.maxTitleSelections <= 30))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['options'])
              || (request.resource.data.options is list
                  && (request.resource.data.mode == 'open'
                      ? request.resource.data.options.size() == 0
                      : request.resource.data.options.size() >= 2
                        && request.resource.data.options.size() <= 10)));
      }

      allow update: if isSecUser()
        && (isListeningOwnerUpdate() || isListeningTeamEditorUpdate())
        && isListeningContentUpdateValid()
        && teamEmailFieldsAreValid();
      allow delete: if isSecUser() && resource.data.ownerUid == request.auth.uid;

      match /entries/{entryId} {
        function ownsParentForm() {
          return isSecUser()
            && get(/databases/$(database)/documents/listeningForms/$(formId)).data.ownerUid == request.auth.uid;
        }

        function followsParentForm() {
          return isSecUser()
            && (request.auth.token.email.lower()
                  in get(/databases/$(database)/documents/listeningForms/$(formId)).data.get('viewerEmails', [])
              || request.auth.token.email.lower()
                  in get(/databases/$(database)/documents/listeningForms/$(formId)).data.get('editorEmails', []));
        }

        function parentFormIsOpen() {
          return get(/databases/$(database)/documents/listeningForms/$(formId)).data.status == 'open';
        }

        function isValidEntryContext() {
          return isString(request.resource.data.name, 2, 80)
            && isString(request.resource.data.occupation, 1, 80)
            && request.resource.data.occupation in [
              'Estudante',
              'Professor da educação básica',
              'Professor Ensino Médio por Intermediação Tecnológica (EMITec)',
              'Professor universitário',
              'Gestor',
              'Coordenação Pedagógica',
              'Outro'
            ]
            && isString(request.resource.data.otherOccupation, 0, 80)
            && (request.resource.data.occupation == 'Outro'
                ? isString(request.resource.data.otherOccupation, 2, 80)
                : request.resource.data.otherOccupation == '')
            && isString(request.resource.data.schoolId, 0, 16)
            && (request.resource.data.schoolId == ''
                || (request.resource.data.schoolId.matches('^[0-9]{1,16}$')
                    && (request.resource.data.schoolId == '1179480'
                        || request.resource.data.schoolId in get(
                          /databases/$(database)/documents/listeningForms/$(formId)
                        ).data.schoolIds)))
            && request.resource.data.createdAt == request.time;
        }

        function isValidOpenEntry() {
          return request.resource.data.keys().hasOnly([
              'name', 'occupation', 'otherOccupation', 'schoolId', 'theme', 'importance', 'question', 'createdAt'
            ])
            && request.resource.data.keys().hasAll([
              'name', 'occupation', 'otherOccupation', 'schoolId', 'theme', 'importance', 'question', 'createdAt'
            ])
            && isValidEntryContext()
            && isString(request.resource.data.theme, 5, 180)
            && isString(request.resource.data.importance, 10, 1200)
            && isString(request.resource.data.question, 0, 800)
            && (!get(/databases/$(database)/documents/listeningForms/$(formId)).data.keys().hasAll(['mode'])
                || get(/databases/$(database)/documents/listeningForms/$(formId)).data.mode == 'open');
        }

        function isValidSubChoiceIndex(titles, index) {
          return index is int
            && index >= 0
            && index < titles.size()
            && isString(titles[index], 1, 180);
        }

        function isValidSubChoiceIndexes(titles, indexes) {
          return indexes is list
            && indexes.size() >= 1
            && indexes.size() <= (
              get(/databases/$(database)/documents/listeningForms/$(formId)).data.keys().hasAll(['maxTitleSelections'])
                ? get(/databases/$(database)/documents/listeningForms/$(formId)).data.maxTitleSelections
                : 4
            )
            && indexes.toSet().size() == indexes.size()
            && isValidSubChoiceIndex(titles, indexes[0])
            && (indexes.size() < 2 || isValidSubChoiceIndex(titles, indexes[1]))
            && (indexes.size() < 3 || isValidSubChoiceIndex(titles, indexes[2]))
            && (indexes.size() < 4 || isValidSubChoiceIndex(titles, indexes[3]))
            && (indexes.size() < 5 || isValidSubChoiceIndex(titles, indexes[4]))
            && (indexes.size() < 6 || isValidSubChoiceIndex(titles, indexes[5]))
            && (indexes.size() < 7 || isValidSubChoiceIndex(titles, indexes[6]))
            && (indexes.size() < 8 || isValidSubChoiceIndex(titles, indexes[7]))
            && (indexes.size() < 9 || isValidSubChoiceIndex(titles, indexes[8]))
            && (indexes.size() < 10 || isValidSubChoiceIndex(titles, indexes[9]))
            && (indexes.size() < 11 || isValidSubChoiceIndex(titles, indexes[10]))
            && (indexes.size() < 12 || isValidSubChoiceIndex(titles, indexes[11]))
            && (indexes.size() < 13 || isValidSubChoiceIndex(titles, indexes[12]))
            && (indexes.size() < 14 || isValidSubChoiceIndex(titles, indexes[13]))
            && (indexes.size() < 15 || isValidSubChoiceIndex(titles, indexes[14]))
            && (indexes.size() < 16 || isValidSubChoiceIndex(titles, indexes[15]))
            && (indexes.size() < 17 || isValidSubChoiceIndex(titles, indexes[16]))
            && (indexes.size() < 18 || isValidSubChoiceIndex(titles, indexes[17]))
            && (indexes.size() < 19 || isValidSubChoiceIndex(titles, indexes[18]))
            && (indexes.size() < 20 || isValidSubChoiceIndex(titles, indexes[19]))
            && (indexes.size() < 21 || isValidSubChoiceIndex(titles, indexes[20]))
            && (indexes.size() < 22 || isValidSubChoiceIndex(titles, indexes[21]))
            && (indexes.size() < 23 || isValidSubChoiceIndex(titles, indexes[22]))
            && (indexes.size() < 24 || isValidSubChoiceIndex(titles, indexes[23]))
            && (indexes.size() < 25 || isValidSubChoiceIndex(titles, indexes[24]))
            && (indexes.size() < 26 || isValidSubChoiceIndex(titles, indexes[25]))
            && (indexes.size() < 27 || isValidSubChoiceIndex(titles, indexes[26]))
            && (indexes.size() < 28 || isValidSubChoiceIndex(titles, indexes[27]))
            && (indexes.size() < 29 || isValidSubChoiceIndex(titles, indexes[28]))
            && (indexes.size() < 30 || isValidSubChoiceIndex(titles, indexes[29]));
        }

        function isValidVoteChoice(options, entry) {
          return entry.choiceIndex < options.size()
            && (options[entry.choiceIndex] is string
              ? !entry.keys().hasAny(['subChoiceIndex', 'subChoiceIndexes'])
              : options[entry.choiceIndex] is map
                && options[entry.choiceIndex].keys().hasOnly(['label', 'titles'])
                && options[entry.choiceIndex].keys().hasAll(['label', 'titles'])
                && isString(options[entry.choiceIndex].label, 1, 180)
                && options[entry.choiceIndex].titles is list
                && options[entry.choiceIndex].titles.size() > 0
                && options[entry.choiceIndex].titles.size() <= 30
                && (entry.keys().hasAll(['subChoiceIndexes'])
                  ? isValidSubChoiceIndexes(
                    options[entry.choiceIndex].titles,
                    entry.subChoiceIndexes
                  )
                  : entry.keys().hasAll(['subChoiceIndex'])
                    && isValidSubChoiceIndex(
                      options[entry.choiceIndex].titles,
                      entry.subChoiceIndex
                    )));
        }

        function isValidSimpleVoteEntry() {
          return request.resource.data.keys().hasOnly([
              'name', 'occupation', 'otherOccupation', 'schoolId',
              'choiceIndex', 'createdAt'
            ])
            && request.resource.data.keys().hasAll([
              'name', 'occupation', 'otherOccupation', 'schoolId', 'choiceIndex', 'createdAt'
            ])
            && isValidEntryContext()
            && request.resource.data.choiceIndex is int
            && request.resource.data.choiceIndex >= 0
            && request.resource.data.choiceIndex < get(/databases/$(database)/documents/listeningForms/$(formId)).data.options.size()
            && get(/databases/$(database)/documents/listeningForms/$(formId)).data.options[request.resource.data.choiceIndex] is string
            && !request.resource.data.keys().hasAny(['subChoiceIndex', 'subChoiceIndexes'])
            && entryId.matches('^[0-9a-fA-F-]{36}$')
            && get(/databases/$(database)/documents/listeningForms/$(formId)).data.mode == 'vote_simple';
        }

        function isValidVoteEntry() {
          return request.resource.data.keys().hasOnly([
              'name', 'occupation', 'otherOccupation', 'schoolId',
              'choiceIndex', 'subChoiceIndex', 'subChoiceIndexes', 'createdAt'
            ])
            && request.resource.data.keys().hasAll([
              'name', 'occupation', 'otherOccupation', 'schoolId', 'choiceIndex', 'createdAt'
            ])
            && isValidEntryContext()
            && request.resource.data.choiceIndex is int
            && request.resource.data.choiceIndex >= 0
            && isValidVoteChoice(
              get(/databases/$(database)/documents/listeningForms/$(formId)).data.options,
              request.resource.data
            )
            && entryId.matches('^[0-9a-fA-F-]{36}$')
            && get(/databases/$(database)/documents/listeningForms/$(formId)).data.mode == 'vote';
        }

        // Dono edita/acompanha; equipe compartilhada (leitor ou editor) acompanha.
        allow get, list: if ownsParentForm() || followsParentForm();
        allow create: if parentFormIsOpen()
          && (isValidOpenEntry() || isValidVoteEntry() || isValidSimpleVoteEntry());
        allow update, delete: if false;
      }
    }

    // ---------- Sessões ao vivo ----------
    function isSessionCreate() {
      return request.resource.data.keys().hasOnly([
          'code', 'title', 'sessionLabel', 'status', 'slides', 'currentSlideIndex',
           'ownerUid', 'ownerEmail', 'presentationId', 'eventKey', 'endedAt',
           'createdAt', 'launchedAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'code', 'title', 'status', 'slides', 'currentSlideIndex',
          'ownerUid', 'ownerEmail', 'createdAt', 'launchedAt', 'updatedAt'
        ])
        && isValidSessionCode(request.resource.data.code)
        && isString(request.resource.data.title, 1, 120)
        && (!request.resource.data.keys().hasAll(['sessionLabel'])
            || isString(request.resource.data.sessionLabel, 0, 80))
        && request.resource.data.status == 'live'
        && isValidSlides(request.resource.data.slides)
        && request.resource.data.currentSlideIndex is int
        && request.resource.data.currentSlideIndex == 0
        && matchesAuthUser(request.resource.data.ownerUid, request.resource.data.ownerEmail)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.launchedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAll(['eventKey'])
            || request.resource.data.eventKey == null
            || isString(request.resource.data.eventKey, 1, 80))
        && (!request.resource.data.keys().hasAll(['presentationId'])
            || request.resource.data.presentationId == null
            || isString(request.resource.data.presentationId, 1, 80));
    }

    function isSessionUpdate() {
      return request.resource.data.keys().hasOnly([
          'code', 'title', 'sessionLabel', 'status', 'slides', 'currentSlideIndex',
           'ownerUid', 'ownerEmail', 'presentationId', 'eventKey', 'endedAt',
           'createdAt', 'launchedAt', 'updatedAt'
        ])
        && request.resource.data.code == resource.data.code
        && request.resource.data.title == resource.data.title
        && ((!request.resource.data.keys().hasAll(['sessionLabel']) && !resource.data.keys().hasAll(['sessionLabel']))
            || (request.resource.data.keys().hasAll(['sessionLabel'])
                && isString(request.resource.data.sessionLabel, 0, 80)))
        && request.resource.data.slides == resource.data.slides
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.presentationId == resource.data.presentationId
        && ((!request.resource.data.keys().hasAll(['eventKey']) && !resource.data.keys().hasAll(['eventKey']))
            || request.resource.data.eventKey == resource.data.eventKey)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.launchedAt == resource.data.launchedAt
        && request.resource.data.currentSlideIndex is int
        && request.resource.data.currentSlideIndex >= 0
        && request.resource.data.currentSlideIndex < resource.data.slides.size()
        // A sessão pode ser encerrada pelo proprietário, mas não reaberta.
        // O cliente envia live -> ended junto com endedAt.
        && request.resource.data.status in ['live', 'ended']
        && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'live' && request.resource.data.status == 'ended'))
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAll(['endedAt'])
            || request.resource.data.endedAt is timestamp);
    }

    // ---------- Relatórios verificáveis de presença ----------
    match /attendanceReports/{reportId} {
      function reportOwner() {
        return isSecUser() && resource.data.ownerUid == request.auth.uid;
      }

      function validHash(value) {
        return isString(value, 64, 64) && value.matches('^[a-f0-9]{64}$');
      }

      allow get: if resource.data.status == 'sealed' || reportOwner();
      allow list: if isSecUser() && resource.data.ownerUid == request.auth.uid;

      allow create: if isSecUser()
        && request.resource.data.keys().hasOnly([
          'reportId', 'source', 'schemaVersion', 'sessionCode', 'sessionTitle',
          'sessionStatus', 'ownerUid', 'ownerEmail', 'participantCount',
          'listHash', 'authorName', 'createdAt', 'status'
        ])
        && request.resource.data.keys().hasAll([
          'reportId', 'source', 'schemaVersion', 'sessionCode', 'sessionTitle',
          'sessionStatus', 'ownerUid', 'ownerEmail', 'participantCount',
          'listHash', 'authorName', 'createdAt', 'status'
        ])
        && request.resource.data.reportId == reportId
        && request.resource.data.source == 'fala-sec'
        && request.resource.data.schemaVersion == 1
        && isValidSessionCode(request.resource.data.sessionCode)
        && isString(request.resource.data.sessionTitle, 1, 120)
        && request.resource.data.sessionStatus in ['live', 'ended']
        && matchesAuthUser(request.resource.data.ownerUid, request.resource.data.ownerEmail)
        && isString(request.resource.data.ownerEmail, 1, 160)
        && request.resource.data.participantCount is int
        && request.resource.data.participantCount >= 0
        && request.resource.data.participantCount <= 5000
        && validHash(request.resource.data.listHash)
        && isString(request.resource.data.authorName, 0, 120)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.status == 'draft'
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionCode)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionCode)).data.status == request.resource.data.sessionStatus;

      allow update: if isSecUser()
        && reportOwner()
        && resource.data.status == 'draft'
        && request.resource.data.keys().hasOnly([
          'reportId', 'source', 'schemaVersion', 'sessionCode', 'sessionTitle',
          'sessionStatus', 'ownerUid', 'ownerEmail', 'participantCount',
          'listHash', 'authorName', 'createdAt', 'status', 'pdfHash', 'sealedAt'
        ])
        && request.resource.data.keys().hasAll([
          'reportId', 'source', 'schemaVersion', 'sessionCode', 'sessionTitle',
          'sessionStatus', 'ownerUid', 'ownerEmail', 'participantCount',
          'listHash', 'authorName', 'createdAt', 'status', 'pdfHash', 'sealedAt'
        ])
        && request.resource.data.reportId == resource.data.reportId
        && request.resource.data.source == resource.data.source
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.sessionCode == resource.data.sessionCode
        && request.resource.data.sessionTitle == resource.data.sessionTitle
        && request.resource.data.sessionStatus == resource.data.sessionStatus
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.participantCount == resource.data.participantCount
        && request.resource.data.listHash == resource.data.listHash
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status == 'sealed'
        && validHash(request.resource.data.pdfHash)
        && request.resource.data.sealedAt is timestamp;

      allow delete: if isSecUser() && resource.data.ownerUid == request.auth.uid;
    }

    match /sessions/{sessionCode} {
      // Public participants can read one live session by its code. The owner
      // can list and read all of their sessions, including ended ones.
      allow get: if resource.data.status == 'live'
        || (isSecUser() && resource.data.ownerUid == request.auth.uid);
      allow list: if isSecUser() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSecUser() && isSessionCreate();
      allow update: if isSecUser() && resource.data.ownerUid == request.auth.uid && isSessionUpdate();
      allow delete: if isSecUser() && resource.data.ownerUid == request.auth.uid;

      function isLiveSession() {
        return get(/databases/$(database)/documents/sessions/$(sessionCode)).data.status == 'live';
      }

      function isValidResponse() {
        return request.resource.data.keys().hasOnly(['participantId', 'participantName', 'slideId', 'type', 'value', 'createdAt'])
          && request.resource.data.keys().hasAll(['participantId', 'participantName', 'slideId', 'type', 'value', 'createdAt'])
          && isString(request.resource.data.participantId, 8, 80)
          && isString(request.resource.data.participantName, 1, 40)
          && isString(request.resource.data.slideId, 1, 80)
          && isSlideType(request.resource.data.type)
          && isString(request.resource.data.value, 1, 220)
          && request.resource.data.createdAt is timestamp;
      }

      match /responses/{responseId} {
        allow read: if true;
        allow create: if isValidSessionCode(sessionCode) && isLiveSession() && isValidResponse();
        allow update: if false;
        allow delete: if sessionOwner(sessionCode);
      }

      function isValidReaction() {
        return request.resource.data.keys().hasOnly(['type', 'left', 'participantId', 'createdAt'])
          && request.resource.data.keys().hasAll(['type', 'left', 'participantId', 'createdAt'])
          && request.resource.data.type in ['heart', 'thumb', 'question']
          && request.resource.data.left is int
          && request.resource.data.left >= 0
          && request.resource.data.left <= 100
          && isString(request.resource.data.participantId, 8, 80)
          && request.resource.data.createdAt is timestamp;
      }

      match /reactions/{reactionId} {
        allow read: if true;
        allow create: if isValidSessionCode(sessionCode) && isLiveSession() && isValidReaction();
        allow update: if false;
        allow delete: if sessionOwner(sessionCode);
      }

      function isValidParticipantPresenceCreate(participantId) {
        return request.resource.data.keys().hasOnly(['participantId', 'participantName', 'participantInstitution', 'participantContact', 'participantCpf', 'attendance', 'joinedAt', 'lastSeenAt'])
          && request.resource.data.keys().hasAll(['participantId', 'participantName', 'joinedAt', 'lastSeenAt'])
          && request.resource.data.participantId == participantId
          && isString(request.resource.data.participantName, 1, 40)
          && request.resource.data.joinedAt is timestamp
          && request.resource.data.lastSeenAt is timestamp
          && (!request.resource.data.keys().hasAll(['participantInstitution'])
              || isString(request.resource.data.participantInstitution, 0, 120))
          && (!request.resource.data.keys().hasAll(['attendance'])
              || request.resource.data.attendance is bool)
          && (!request.resource.data.keys().hasAll(['participantContact'])
              || isString(request.resource.data.participantContact, 0, 120))
          && (!request.resource.data.keys().hasAll(['participantCpf'])
              || isString(request.resource.data.participantCpf, 0, 11))
          && (!(request.resource.data.keys().hasAll(['attendance']) && request.resource.data.attendance == true)
              || (request.resource.data.keys().hasAll(['participantInstitution', 'participantContact', 'participantCpf'])
                  && isString(request.resource.data.participantInstitution, 1, 120)
                  && isString(request.resource.data.participantContact, 5, 120)
                  && isString(request.resource.data.participantCpf, 11, 11)));
      }

      function isValidParticipantPresenceUpdate(participantId) {
        return request.resource.data.keys().hasOnly(['participantId', 'participantName', 'participantInstitution', 'participantContact', 'participantCpf', 'attendance', 'joinedAt', 'lastSeenAt'])
          && request.resource.data.participantId == participantId
          && request.resource.data.participantId == resource.data.participantId
          && request.resource.data.joinedAt == resource.data.joinedAt
          && isString(request.resource.data.participantName, 1, 40)
          && request.resource.data.lastSeenAt is timestamp
          && (!request.resource.data.keys().hasAll(['participantInstitution'])
              || isString(request.resource.data.participantInstitution, 0, 120))
          && (!request.resource.data.keys().hasAll(['attendance'])
              || request.resource.data.attendance is bool)
          && (!request.resource.data.keys().hasAll(['participantContact'])
              || isString(request.resource.data.participantContact, 0, 120))
          && (!request.resource.data.keys().hasAll(['participantCpf'])
              || isString(request.resource.data.participantCpf, 0, 11))
          && (!resource.data.keys().hasAll(['attendance'])
              || resource.data.attendance == false
              || (request.resource.data.keys().hasAll(['attendance']) && request.resource.data.attendance == true))
          && (!(resource.data.keys().hasAll(['attendance']) && resource.data.attendance == true)
              || (request.resource.data.keys().hasAll(['participantInstitution', 'participantContact', 'participantCpf'])
                  && isString(request.resource.data.participantInstitution, 1, 120)
                  && isString(request.resource.data.participantContact, 5, 120)
                  && isString(request.resource.data.participantCpf, 11, 11)));
      }

      match /participants/{participantId} {
        allow read: if true;
        allow create: if isValidSessionCode(sessionCode) && isLiveSession() && isValidParticipantPresenceCreate(participantId);
        allow update: if isValidSessionCode(sessionCode) && isLiveSession() && isValidParticipantPresenceUpdate(participantId);
        allow delete: if sessionOwner(sessionCode);
      }
    }
  }
}
