rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isSlideType(value) {
      return value in ['multiple_choice', 'word_cloud', 'open_text', 'team_selection'];
    }

    function isValidSessionCode(value) {
      return value is string && value.matches('^[A-Z0-9]{6}$');
    }

    function isSecDomain(email) {
      return email is string
        && email.matches('.*@(secti\\.ba\\.gov\\.br|enova\\.educacao\\.ba\\.gov\\.br|gmail\\.com)$');
    }

    function isSecUser() {
      return request.auth != null
        && isSecDomain(request.auth.token.email);
    }

    function matchesAuthUser(ownerUid, ownerEmail) {
      return ownerUid == request.auth.uid
        && ownerEmail == request.auth.token.email;
    }

    // Validação de envelope dos slides (validação profunda por slide fica no app).
    function isValidSlides(slides) {
      return slides is list && slides.size() > 0 && slides.size() <= 20;
    }

    function sessionOwner(code) {
      return isSecUser()
        && get(/databases/$(database)/documents/sessions/$(code)).data.ownerUid == request.auth.uid;
    }

    // ---------- Apresentações (decks salvos e editáveis) ----------
    match /presentations/{presentationId} {
      allow read: if isSecUser() && resource.data.ownerUid == request.auth.uid;

      allow create: if isSecUser()
        && request.resource.data.keys().hasOnly(['title', 'slides', 'ownerUid', 'ownerEmail', 'eventKey', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['title', 'slides', 'ownerUid', 'ownerEmail', 'createdAt', 'updatedAt'])
        && matchesAuthUser(request.resource.data.ownerUid, request.resource.data.ownerEmail)
        && isString(request.resource.data.title, 1, 120)
        && isValidSlides(request.resource.data.slides)
        && (!request.resource.data.keys().hasAll(['eventKey'])
            || request.resource.data.eventKey == null
            || isString(request.resource.data.eventKey, 1, 80))
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
        // eventKey identifies an institutional event template and is optional for old decks.

      allow update: if isSecUser()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['title', 'slides', 'ownerUid', 'ownerEmail', 'eventKey', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && isString(request.resource.data.title, 1, 120)
        && isValidSlides(request.resource.data.slides)
        && (!request.resource.data.keys().hasAll(['eventKey'])
            || request.resource.data.eventKey == null
            || isString(request.resource.data.eventKey, 1, 80))
        && request.resource.data.updatedAt is timestamp;

      allow delete: if isSecUser() && resource.data.ownerUid == request.auth.uid;
    }

    // ---------- Sessões ao vivo ----------
    function isSessionCreate() {
      return request.resource.data.keys().hasOnly([
          'code', 'title', 'status', 'slides', 'currentSlideIndex',
           'ownerUid', 'ownerEmail', 'presentationId', 'eventKey', 'endedAt',
           'createdAt', 'launchedAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'code', 'title', 'status', 'slides', 'currentSlideIndex',
          'ownerUid', 'ownerEmail', 'createdAt', 'launchedAt', 'updatedAt'
        ])
        && isValidSessionCode(request.resource.data.code)
        && isString(request.resource.data.title, 1, 120)
        && request.resource.data.status == 'live'
        && isValidSlides(request.resource.data.slides)
        && request.resource.data.currentSlideIndex is int
        && request.resource.data.currentSlideIndex == 0
        && matchesAuthUser(request.resource.data.ownerUid, request.resource.data.ownerEmail)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.launchedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAll(['eventKey'])
            || request.resource.data.eventKey == null
            || isString(request.resource.data.eventKey, 1, 80))
        && (!request.resource.data.keys().hasAll(['presentationId'])
            || request.resource.data.presentationId == null
            || isString(request.resource.data.presentationId, 1, 80));
    }

    function isSessionUpdate() {
      return request.resource.data.keys().hasOnly([
          'code', 'title', 'status', 'slides', 'currentSlideIndex',
           'ownerUid', 'ownerEmail', 'presentationId', 'eventKey', 'endedAt',
           'createdAt', 'launchedAt', 'updatedAt'
        ])
        && request.resource.data.code == resource.data.code
        && request.resource.data.title == resource.data.title
        && request.resource.data.slides == resource.data.slides
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.presentationId == resource.data.presentationId
        && ((!request.resource.data.keys().hasAll(['eventKey']) && !resource.data.keys().hasAll(['eventKey']))
            || request.resource.data.eventKey == resource.data.eventKey)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.launchedAt == resource.data.launchedAt
        && request.resource.data.currentSlideIndex is int
        && request.resource.data.currentSlideIndex >= 0
        && request.resource.data.currentSlideIndex < resource.data.slides.size()
        && request.resource.data.status == resource.data.status
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAll(['endedAt'])
            || request.resource.data.endedAt is timestamp);
    }

    match /sessions/{sessionCode} {
      // Public participants can read one live session by its code. The owner
      // can list and read all of their sessions, including ended ones.
      allow get: if resource.data.status == 'live'
        || (isSecUser() && resource.data.ownerUid == request.auth.uid);
      allow list: if isSecUser() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSecUser() && isSessionCreate();
      allow update: if isSecUser() && resource.data.ownerUid == request.auth.uid && isSessionUpdate();
      allow delete: if isSecUser() && resource.data.ownerUid == request.auth.uid;

      function isLiveSession() {
        return get(/databases/$(database)/documents/sessions/$(sessionCode)).data.status == 'live';
      }

      function isValidResponse() {
        return request.resource.data.keys().hasOnly(['participantId', 'participantName', 'slideId', 'type', 'value', 'createdAt'])
          && request.resource.data.keys().hasAll(['participantId', 'participantName', 'slideId', 'type', 'value', 'createdAt'])
          && isString(request.resource.data.participantId, 8, 80)
          && isString(request.resource.data.participantName, 1, 40)
          && isString(request.resource.data.slideId, 1, 80)
          && isSlideType(request.resource.data.type)
          && isString(request.resource.data.value, 1, 220)
          && request.resource.data.createdAt is timestamp;
      }

      match /responses/{responseId} {
        allow read: if true;
        allow create: if isValidSessionCode(sessionCode) && isLiveSession() && isValidResponse();
        allow update: if false;
        allow delete: if sessionOwner(sessionCode);
      }

      function isValidReaction() {
        return request.resource.data.keys().hasOnly(['type', 'left', 'participantId', 'createdAt'])
          && request.resource.data.keys().hasAll(['type', 'left', 'participantId', 'createdAt'])
          && request.resource.data.type in ['heart', 'thumb', 'question']
          && request.resource.data.left is int
          && request.resource.data.left >= 0
          && request.resource.data.left <= 100
          && isString(request.resource.data.participantId, 8, 80)
          && request.resource.data.createdAt is timestamp;
      }

      match /reactions/{reactionId} {
        allow read: if true;
        allow create: if isValidSessionCode(sessionCode) && isLiveSession() && isValidReaction();
        allow update: if false;
        allow delete: if sessionOwner(sessionCode);
      }

      function isValidParticipantPresenceCreate(participantId) {
        return request.resource.data.keys().hasOnly(['participantId', 'participantName', 'participantInstitution', 'participantContact', 'participantCpf', 'attendance', 'joinedAt', 'lastSeenAt'])
          && request.resource.data.keys().hasAll(['participantId', 'participantName', 'joinedAt', 'lastSeenAt'])
          && request.resource.data.participantId == participantId
          && isString(request.resource.data.participantName, 1, 40)
          && request.resource.data.joinedAt is timestamp
          && request.resource.data.lastSeenAt is timestamp
          && (!request.resource.data.keys().hasAll(['participantInstitution'])
              || isString(request.resource.data.participantInstitution, 0, 120))
          && (!request.resource.data.keys().hasAll(['attendance'])
              || request.resource.data.attendance is bool)
          && (!request.resource.data.keys().hasAll(['participantContact'])
              || isString(request.resource.data.participantContact, 0, 120))
          && (!request.resource.data.keys().hasAll(['participantCpf'])
              || isString(request.resource.data.participantCpf, 0, 11))
          && (!(request.resource.data.keys().hasAll(['attendance']) && request.resource.data.attendance == true)
              || (request.resource.data.keys().hasAll(['participantInstitution', 'participantContact', 'participantCpf'])
                  && isString(request.resource.data.participantInstitution, 1, 120)
                  && isString(request.resource.data.participantContact, 5, 120)
                  && isString(request.resource.data.participantCpf, 11, 11)));
      }

      function isValidParticipantPresenceUpdate(participantId) {
        return request.resource.data.keys().hasOnly(['participantId', 'participantName', 'participantInstitution', 'participantContact', 'participantCpf', 'attendance', 'joinedAt', 'lastSeenAt'])
          && request.resource.data.participantId == participantId
          && request.resource.data.participantId == resource.data.participantId
          && request.resource.data.joinedAt == resource.data.joinedAt
          && isString(request.resource.data.participantName, 1, 40)
          && request.resource.data.lastSeenAt is timestamp
          && (!request.resource.data.keys().hasAll(['participantInstitution'])
              || isString(request.resource.data.participantInstitution, 0, 120))
          && (!request.resource.data.keys().hasAll(['attendance'])
              || request.resource.data.attendance is bool)
          && (!request.resource.data.keys().hasAll(['participantContact'])
              || isString(request.resource.data.participantContact, 0, 120))
          && (!request.resource.data.keys().hasAll(['participantCpf'])
              || isString(request.resource.data.participantCpf, 0, 11))
          && (!resource.data.keys().hasAll(['attendance'])
              || resource.data.attendance == false
              || (request.resource.data.keys().hasAll(['attendance']) && request.resource.data.attendance == true))
          && (!(resource.data.keys().hasAll(['attendance']) && resource.data.attendance == true)
              || (request.resource.data.keys().hasAll(['participantInstitution', 'participantContact', 'participantCpf'])
                  && isString(request.resource.data.participantInstitution, 1, 120)
                  && isString(request.resource.data.participantContact, 5, 120)
                  && isString(request.resource.data.participantCpf, 11, 11)));
      }

      match /participants/{participantId} {
        allow read: if true;
        allow create: if isValidSessionCode(sessionCode) && isLiveSession() && isValidParticipantPresenceCreate(participantId);
        allow update: if isValidSessionCode(sessionCode) && isLiveSession() && isValidParticipantPresenceUpdate(participantId);
        allow delete: if sessionOwner(sessionCode);
      }
    }
  }
}
